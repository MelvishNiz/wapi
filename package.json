{
  "version": "1.0.0",
  "name": "wapi",
  "title": "WAPI",
  "description": "This API provides an interface for sending and receiving WhatsApp messages over a REST connection.",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run index.ts",
    "dev:watch": "bun run --watch index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server index.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "dev:panel": "vite",
    "build:panel": "vite build",
    "preview:panel": "vite preview",
    "build:all": "bun run build && bun run build:panel",
    "start": "./server"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.7.0",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/openapi": "^1.3.12",
    "@elysiajs/static": "^1.3.0",
    "@hapi/boom": "^10.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "axios": "^1.11.0",
    "baileys": "^7.0.0-rc.2",
    "elysia": "^1.3.21",
    "event-source-polyfill": "^1.0.31",
    "pino": "^9.9.5",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.13",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/material-symbols": "^1.2.34",
    "@iconify/tailwind4": "^1.0.6",
    "@tsconfig/node22": "^22.0.2",
    "@types/bun": "^1.2.21",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "dotenv": "^17.2.2",
    "pino-pretty": "^13.1.1",
    "vite": "^7.1.5"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  }
}
